APP_NAME="Login App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Con "docker compose up" queda expuesto en tu equipo en el puerto 5433.
# (Dentro de Docker estos valores no se usan: los pone docker-compose.yml.)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=netfic
DB_USERNAME=netfic
DB_PASSWORD=netfic
DB_SSLMODE=disable
DB_PERSISTENT=false
DB_EMULATE_PREPARES=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo: "log" lo guarda en storage/logs/laravel.log; "smtp" lo envía de verdad.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587 y una contraseña de aplicación
# (https://myaccount.google.com/apppasswords) en MAIL_PASSWORD.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Catálogo multimedia en MongoDB. Con "docker compose up" queda en el puerto 27018.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=netfic

# Python con yt-dlp para importar frutinovelas (php artisan content:import-youtube)
PYTHON_BIN=python
