APP_NAME="Login App"
APP_ENV=development
APP_URL=http://localhost:8000
APP_PORT=8000

SESSION_SECRET=
SESSION_LIFETIME=120

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=proyecto
DB_USERNAME=proyecto_app
DB_PASSWORD=
DB_SSL=false

# Correo: "log" guarda los correos en logs/mail.log; "smtp" los envía de verdad.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=tu correo,
# MAIL_PASSWORD=contraseña de aplicación (https://myaccount.google.com/apppasswords).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Login App"
