{
  "name": "login-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:client": "esbuild client/movie-background/main.jsx --bundle --minify --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/build/movie-background.js",
    "prestart": "npm run build:client",
    "start": "node src/server.js",
    "predev": "npm run build:client",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "mail:test": "node scripts/test-mail.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.0"
  }
}
