<!-- Campo Contraseña -->
<div class="input-group">
    <input type="password" id="password" name="password" placeholder=" " required autocomplete="new-password">
    <label for="password">Contraseña</label>
</div>

<!-- Reglas de validación visual -->
<ul id="password-rules" class="rules">
    <li data-rule="^.{8,64}$">Entre 8 y 64 caracteres</li>
    <li data-rule="[a-z]">Una letra minúscula</li>
    <li data-rule="[A-Z]">Una letra mayúscula</li>
    <li data-rule="\d">Un número</li>
    <li data-rule="[^A-Za-z0-9\s]">Un símbolo (ej. ! @ # $ %)</li>
    <li data-rule="^\S*$">Sin espacios</li>
</ul>

<!-- Campo Confirmar Contraseña -->
<div class="input-group">
    <input type="password" id="password_confirmation" name="password_confirmation" placeholder=" " required autocomplete="new-password">
    <label for="password_confirmation">Confirmar contraseña</label>
</div>

<script>
    // Ayuda visual: se sincroniza con el CSS de .rules li.ok
    document.getElementById('password')?.addEventListener('input', function () {
        document.querySelectorAll('#password-rules li').forEach((li) => {
            li.classList.toggle('ok', new RegExp(li.dataset.rule).test(this.value));
        });
    });
</script>