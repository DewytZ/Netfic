<label>Contraseña <input type="password" name="password" id="password" required autocomplete="new-password"></label>
<ul id="password-rules" class="rules">
    <li data-rule="^.{8,64}$">Entre 8 y 64 caracteres</li>
    <li data-rule="[a-z]">Una letra minúscula</li>
    <li data-rule="[A-Z]">Una letra mayúscula</li>
    <li data-rule="\d">Un número</li>
    <li data-rule="[^A-Za-z0-9\s]">Un símbolo (por ejemplo ! @ # $ %)</li>
    <li data-rule="^\S*$">Sin espacios</li>
</ul>
<label>Confirmar contraseña <input type="password" name="password_confirmation" required autocomplete="new-password"></label>

<script>
    // Solo es una ayuda visual: la validación real la hace el servidor con PASSWORD_REGEX.
    document.getElementById('password').addEventListener('input', function () {
        document.querySelectorAll('#password-rules li').forEach((li) => {
            li.classList.toggle('ok', new RegExp(li.dataset.rule).test(this.value));
        });
    });
</script>
