<%- include('../partials/header') %>

<div class="auth-card" id="resetPasswordCard">
    <h1 class="auth-title">Nueva contraseña</h1>
    <p class="auth-description">Ingresa tu correo y define tu nueva contraseña para recuperar el acceso a tu cuenta.</p>

    <form method="POST" action="/reset-password" id="resetPasswordForm">
        <input type="hidden" name="_token" value="<%= csrfToken %>">
        <input type="hidden" name="token" value="<%= token %>">

        <!-- Campo Email -->
        <div class="input-group">
            <input type="email" id="email" name="email" value="<%= email %>" placeholder=" " required>
            <label for="email">Correo electrónico</label>
        </div>

        <!-- Parcial de Contraseñas (Campos + Reglas visuales) -->
        <%- include('partials/password-fields') %>

        <!-- Botón de Confirmación -->
        <button type="submit" class="btn-primary" id="btnSubmit">Guardar contraseña</button>
    </form>

    <!-- Enlace de retorno -->
    <div class="auth-switch">
        <a href="/login">← Volver a iniciar sesión</a>
    </div>
</div>

<%- include('../partials/footer') %>