<%- include('../partials/header') %>

<div class="auth-card" id="loginCard">
    <h1 class="auth-title">Iniciar sesión</h1>
    <p class="auth-description">Ingresa tus credenciales para acceder a la plataforma.</p>

    <%- include('../partials/alerts') %>

    <form method="POST" action="/login" id="loginForm">
        <input type="hidden" name="_token" value="<%= csrfToken %>">

        <div class="input-group<%= errors.length ? ' has-error' : '' %>">
            <input type="email" id="email" name="email" value="<%= old.email ?? '' %>" placeholder=" " required autocomplete="email"<%= errors.length ? '' : ' autofocus' %>>
            <label for="email">Correo electrónico</label>
        </div>

        <div class="input-group<%= errors.length ? ' has-error' : '' %>">
            <input type="password" id="password" name="password" placeholder=" " required autocomplete="current-password"<%= errors.length ? ' autofocus' : '' %>>
            <label for="password">Contraseña</label>
        </div>

        <div class="auth-options">
            <label class="remember-me">
                <input type="checkbox" name="remember">
                Recordarme
            </label>
            <a href="/forgot-password" class="auth-link">¿Olvidaste tu contraseña?</a>
        </div>

        <button type="submit" class="btn-primary" id="btnSubmit">Continuar</button>
    </form>

    <div class="auth-switch">
        ¿No tienes cuenta? <a href="/register">Regístrate aquí</a>.
    </div>
</div>

<%- include('../partials/footer') %>