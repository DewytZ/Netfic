<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="/css/styles.css">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= appName %></title>
    <div class="logo-netflix">
        <p>Netflix</p>
    </div>
    <style>
        body { font-family: sans-serif; max-width: 400px; margin: 60px auto; padding: 0 16px; }
        label { display: block; margin-top: 12px; }
        input[type=text], input[type=email], input[type=password] { width: 100%; padding: 8px; box-sizing: border-box; }
        button { margin-top: 16px; padding: 8px 16px; cursor: pointer; }
        .error { color: #b00020; }
        .status { color: #1b5e20; }
        .rules { font-size: 14px; color: #666; padding-left: 20px; margin: 6px 0; }
        .rules li::marker { content: "✗  "; color: #b00020; }
        .rules li.ok { color: #1b5e20; }
        .rules li.ok::marker { content: "✓  "; color: #1b5e20; }
    </style>
</head>
<body>
    <% if (status) { %>
        <p class="status"><%= status %></p>
    <% } %>

    <% if (errors.length) { %>
        <ul class="error">
            <% errors.forEach((error) => { %>
                <li><%= error %></li>
            <% }) %>
        </ul>
    <% } %>
