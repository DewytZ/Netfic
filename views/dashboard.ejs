<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio - <%= appName %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/build/browse.css">
</head>
<body class="browse-body">
    <% if (status) { %>
        <div class="toast status-toast nf-status-toast" role="status"><p><%= status %></p></div>
    <% } %>

    <%# Catálogo tipo Netflix (componente React en client/browse) %>
    <div id="browse"
         data-user="<%= JSON.stringify({ name: user.name, email: user.email }) %>"
         data-csrf="<%= csrfToken %>"></div>

    <noscript>
        <div class="auth-wrapper">
            <p>Activa JavaScript para ver el catálogo, <%= user.name %>.</p>
            <form method="POST" action="/logout">
                <input type="hidden" name="_token" value="<%= csrfToken %>">
                <button type="submit" class="btn-logout">Cerrar sesión</button>
            </form>
        </div>
    </noscript>

    <script src="/build/browse.js" defer></script>
</body>
</html>
