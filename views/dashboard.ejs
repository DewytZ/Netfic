<%- include('partials/header') %>

<div class="auth-card dashboard-card" id="dashboardCard">
    <%- include('partials/alerts') %>

    <div class="user-avatar" aria-hidden="true"><%= user.name.trim().charAt(0).toUpperCase() %></div>

    <h1 class="auth-title">Hola, <%= user.name %></h1>
    <p class="auth-description"><%= user.email %></p>

    <form method="POST" action="/logout" id="logoutForm">
        <input type="hidden" name="_token" value="<%= csrfToken %>">
        <button type="submit" class="btn-logout" id="btnLogout">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
            Cerrar sesión
        </button>
    </form>
</div>

<%- include('partials/footer') %>
